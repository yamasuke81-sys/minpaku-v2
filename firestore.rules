rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // オーナー: 全データ読み書き可能。
    // 原則 role=='owner' クレームを持つアカウントのみ。ログイン時に checkIfOwnerUid が
    // メインオーナー(staff.isOwner===true)へ必ず role:"owner" を付与するため、正規オーナーは常にこれを満たす。
    // ★role 未設定(null)を owner 扱いする旧フォールバックは撤去した(未招待の自己登録アカウントが
    //   全権限 owner に化ける穴だったため)。唯一の例外として、既知のメインオーナー UID のみ
    //   ブレークグラス(クレーム未反映でもロックアウトしない安全弁)として null を許容する。
    function isOwner() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.auth.token.role == 'owner'
            || (!('role' in request.auth.token) && request.auth.uid == 'rwHczfRz8DfnWCrQ7yeAYnsd8in2'));
    }

    // サブオーナー: role == sub_owner
    function isSubOwner() {
      return request.auth != null && request.auth.token.role == 'sub_owner';
    }

    // スタッフ: 認証済み + role == staff
    function isStaff() {
      return request.auth != null && request.auth.token.role == 'staff';
    }

    // 認証済みユーザー（owner / sub_owner / staff 全て含む）
    function isAuthenticated() {
      return request.auth != null;
    }

    // カスタムクレームのstaffIdを取得（Firestoreルールでスタッフ本人チェックに使用）
    function myStaffId() {
      return request.auth.token.staffId;
    }

    // 指定物件IDへのアクセス権チェック
    // オーナー: 全物件OK、サブオーナー: 所有物件のみ、スタッフ: false（読取は別途許可）
    function isMyProperty(pid) {
      return isOwner() || (isSubOwner() && pid in request.auth.token.ownedPropertyIds);
    }

    // レギュラー清掃スタッフ (active かつ タイミー以外) が pid を担当しているか
    // 同一 staff doc への複数 get() はデデュープされ 1 read で済む
    function isRegularStaffFor(pid) {
      return isStaff()
        && get(/databases/$(database)/documents/staff/$(myStaffId())).data.get('isTimee', false) != true
        && get(/databases/$(database)/documents/staff/$(myStaffId())).data.get('active', true) != false
        && pid in get(/databases/$(database)/documents/staff/$(myStaffId())).data.get('assignedPropertyIds', []);
    }

    // スタッフマスタ — オーナーは全操作、サブオーナーは自所有物件担当スタッフのみ更新可
    // スタッフ/サブオーナーは自分のデータ + アクティブスタッフ全員の名前/IDを読み取り可能
    // (my-recruitment のカレンダーでスタッフ一覧を表示するために必要)
    // サブオーナー権限昇格防止: isSubOwner / ownedPropertyIds / role / authUid 等の更新は不可
    match /staff/{staffId} {
      allow read: if isOwner()
        || isSubOwner()
        || (isStaff() && myStaffId() == staffId)
        || (isStaff() && resource.data.active == true);
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (isSubOwner()
            && resource.data.assignedPropertyIds is list
            && resource.data.assignedPropertyIds.hasAny(request.auth.token.ownedPropertyIds)
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['isSubOwner', 'ownedPropertyIds', 'role', 'authUid',
                           'subOwnerLineUserId', 'subOwnerEmail', 'isOwner']))
        // スタッフが自分自身のプロフィール (氏名/電話/住所/メール/口座情報等) を更新可能
        // ただし権限昇格防止のため特定フィールドは変更不可
        || (isStaff() && myStaffId() == staffId
            && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['isSubOwner', 'ownedPropertyIds', 'role', 'authUid',
                           'isOwner', 'assignedPropertyIds', 'active', 'displayOrder',
                           'lineUserId', 'staffId']));

      // ★機微情報サブコレクション (private/details):
      //   電話/住所/銀行口座/請求名義(billingProfiles)/契約書URL等。
      //   本体 doc は「active スタッフなら full doc を相互閲覧可」(清掃カレンダー用) のため、
      //   機微はここに分離して owner / 本人 / 担当物件の sub_owner のみに限定する。
      //   同僚スタッフは互いの private を読めない。
      match /private/{docId} {
        allow read, write: if isOwner()
          || (isStaff() && myStaffId() == staffId)
          || (isSubOwner()
              && get(/databases/$(database)/documents/staff/$(staffId)).data.get('assignedPropertyIds', [])
                   .hasAny(request.auth.token.ownedPropertyIds));
      }
    }

    // 物件 — read は全認証ユーザー (各画面が properties を全件クエリするため)
    // write はオーナー全件、サブオーナーは自所有物件のみ
    // ※ サブオーナーの「自物件のみ表示」は UI 側 (properties.js) の filter で実現
    match /properties/{propertyId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (isSubOwner() && propertyId in request.auth.token.ownedPropertyIds);

      // ★秘密情報サブコレクション (private/secrets):
      //   Wi-Fiパスワード / キーボックス暗証番号 / LINE Botトークン / 取得価格 / 内部メモ等。
      //   本体 doc は全認証ユーザー read のため、秘密はここに分離して owner / 所有sub_owner に限定。
      //   staff・匿名は read 不可。バックエンドは utils/propertySecrets.js のマージ取得を使う。
      match /private/{docId} {
        allow read, write: if isOwner()
          || (isSubOwner() && propertyId in request.auth.token.ownedPropertyIds);
      }
    }

    // 予約 — オーナーは全操作、サブオーナーは所有物件のみ読み書き。
    // スタッフは直読み禁止 (PII を含むため) → /api/staff-data 経由で PII 除外サマリのみ取得する。
    // ★read も isMyProperty で物件スコープ(旧: isSubOwner() 無条件=全物件のゲストPIIが読めた穴)。
    //   フロントは sub_owner 時 where("propertyId","in",ownedPropertyIds) で絞る(my-recruitment.js 等)。
    match /bookings/{bookingId} {
      allow read: if isMyProperty(resource.data.propertyId);
      allow write: if isOwner() || (isSubOwner() && isMyProperty(resource.data.propertyId));
    }

    // Stripe Webhook 冪等性チェック用 (event.id をキーに重複処理を防ぐ)
    // 書き込みは Cloud Functions (Admin SDK) のみ。クライアントは触らない。
    match /stripeWebhookEvents/{eventId} {
      allow read, write: if false;
    }

    // スタッフ向けデータ更新通知カウンタ (PII なし)。書き込みは Cloud Functions (Admin SDK) のみ。
    // スタッフ端末はこの1件だけを onSnapshot 監視し、変化時に /api/staff-data を再取得する。
    match /meta/staffDataVersion {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // シフト — オーナーは全操作、サブオーナーは所有物件のみ読み取り、スタッフは自分のシフトのみ読み取り
    match /shifts/{shiftId} {
      allow read: if isOwner()
        || (isSubOwner() && isMyProperty(resource.data.propertyId))
        || (isStaff() && resource.data.staffId == myStaffId());
      allow write: if isOwner() || (isSubOwner() && isMyProperty(resource.data.propertyId));
    }

    // コインランドリー — スタッフは自分の記録を作成・読み取り、サブオーナーは所有物件を閲覧、オーナーは全操作
    match /laundry/{recordId} {
      allow read: if isOwner()
        || (isSubOwner() && isMyProperty(resource.data.propertyId))
        || (isStaff() && resource.data.staffId == myStaffId());
      allow create: if isStaff() && request.resource.data.staffId == myStaffId();
      allow update, delete: if isOwner();
    }

    // 請求書 — オーナーは全操作、スタッフは自分の請求書の読み取り+ステータス更新
    match /invoices/{invoiceId} {
      allow read: if isOwner() || (isStaff() && resource.data.staffId == myStaffId());
      allow create, delete: if isOwner();
      allow update: if isOwner() ||
        (isStaff() && resource.data.staffId == myStaffId()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']));
    }

    // 請求書除外設定 (docId=`{yearMonth}_{staffId}` または `{yearMonth}_{staffId}_{propertyId}`)
    // オーナー: 全操作、スタッフ: 自分の除外設定のみ read/write
    // split("_")[1] で staffId 部分を取得 (yearMonth は YYYY-MM で "_" を含まないため安全)
    match /invoiceExclusions/{docId} {
      allow read: if isOwner()
        || (isStaff() && docId.split("_")[1] == myStaffId());
      allow write: if isOwner()
        || (isStaff() && docId.split("_")[1] == myStaffId());
    }

    // チェックリスト — 読取は全スタッフ+サブオーナー+オーナー可(履歴確認用)
    // 更新: 割当済みスタッフ OR 担当物件に紐づくスタッフ (シフト未確定時でも操作可能)
    match /checklists/{checklistId} {
      // ヘルパー (認証なし) からの onSnapshot リアルタイム購読を許可するため public read
      // 書き込みは引き続き制限 (Cloud Function 経由 = admin 権限で実行)
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isOwner()
        // サブオーナー: 所有物件のチェックリストは全て更新可
        || (isSubOwner() && resource.data.propertyId in request.auth.token.ownedPropertyIds)
        || (isStaff() && (
            resource.data.staffId == myStaffId()
            || (resource.data.staffIds is list && myStaffId() in resource.data.staffIds)
            // 割り当て未確定でも、担当物件のスタッフなら操作可能
            || (resource.data.propertyId != null
                && resource.data.propertyId in get(/databases/$(database)/documents/staff/$(myStaffId())).data.assignedPropertyIds)
          ));
      allow delete: if isOwner();
    }

    // クライアント側エラー収集 (リモート診断用)
    // - 全ユーザー (認証/未認証問わず) が write 可能
    // - read はオーナーのみ
    match /client_errors/{id} {
      // 未認証で作成可だがフィールドとサイズを制限 (スパム/肥大化対策)
      allow create: if request.resource.data.keys().hasOnly(
            ['type','message','source','lineno','colno','stack','ua','url','uid','createdAt'])
          && request.resource.data.type is string && request.resource.data.type.size() < 50
          && request.resource.data.message is string && request.resource.data.message.size() < 4000
          && (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() < 4000))
          && (!('ua' in request.resource.data) || (request.resource.data.ua is string && request.resource.data.ua.size() < 500))
          && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() < 1000));
      allow read: if isOwner();
    }

    // チェックリストテンプレート — 読み取りは誰でも (ゲスト用未認証 URL 対応)
    // ゲストが /guest-checklist.html?p={pid} で QR から閲覧可能にする
    // 書き込み: オーナー / サブオーナー(所有物件) / レギュラー清掃スタッフ(担当物件)
    // docId は {propertyId}_{workType}。propertyId フィールドはトリガーの同期対象を決めるため
    // docId との一致を強制し、偽装による他物件 checklists の汚染を防ぐ
    match /checklistTemplates/{templateId} {
      allow read: if true;
      allow delete: if isOwner();
      allow create, update: if isOwner()
        || (
             ((isSubOwner() && templateId.split('_')[0] in request.auth.token.ownedPropertyIds)
              || isRegularStaffFor(templateId.split('_')[0]))
             && request.resource.data.propertyId == templateId.split('_')[0]
           );

      // 保存履歴 — 読み取りのみ許可。write ルールなし = クライアント全拒否 (トリガー Admin SDK のみ書く)
      match /history/{historyId} {
        allow read: if isAuthenticated();
      }
    }

    // チェックリストマスタ — オーナーのみ書き込み、全員読み取り
    match /checklistMaster/{docId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // 物件別 作業項目・単価マスタ — オーナーのみ書き込み、認証済み読み取り
    match /propertyWorkItems/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();

      // 月別単価スナップショット (onPropertyWorkItemsWrite が自動保存)
      // 過去月の請求書画面がサーバーと同じ単価を表示するために読み取りを許可。
      // 書き込みは原則 Admin SDK のみだが、「翌月1日から反映」予約 (rates.js) の
      // 当月凍結 doc (archivedBy=ratesNextMonthApply) に限りオーナーが作成/取消できる。
      // トリガー由来の確定スナップショットはオーナーでも削除不可 (締め済み月の保護)
      match /history/{yearMonth} {
        allow read: if isAuthenticated();
        allow create: if isOwner() && request.resource.data.archivedBy == "ratesNextMonthApply";
        allow delete: if isOwner() && resource.data.archivedBy == "ratesNextMonthApply";
      }
    }

    // 募集管理 — オーナーは全操作、サブオーナーは所有物件のみ操作、スタッフは読み取り+自分の回答更新のみ
    match /recruitments/{recruitmentId} {
      allow read: if isAuthenticated();
      allow create, delete: if isOwner() || (isSubOwner() && isMyProperty(resource.data.propertyId));
      // スタッフは responses / changeRequests / updatedAt のみ更新可能 (担当物件のみ)
      // サブオーナーは所有物件の募集を更新可能
      allow update: if isOwner()
        || (isSubOwner() && isMyProperty(resource.data.propertyId))
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['responses', 'changeRequests', 'updatedAt'])
            && (resource.data.propertyId == null
                || resource.data.propertyId in get(/databases/$(database)/documents/staff/$(myStaffId())).data.assignedPropertyIds));

      // 回答サブコレクション — スタッフは自分の回答を作成・更新、オーナーは全操作、サブオーナーは所有物件のみ
      match /responses/{responseId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isOwner()
          || (isSubOwner() && isMyProperty(get(/databases/$(database)/documents/recruitments/$(recruitmentId)).data.propertyId))
          || (isStaff() && resource.data.staffId == myStaffId());
        allow delete: if isOwner()
          || (isSubOwner() && isMyProperty(get(/databases/$(database)/documents/recruitments/$(recruitmentId)).data.propertyId))
          || (isStaff() && resource.data.staffId == myStaffId());
      }
    }

    // 宿泊者名簿 — ゲストフォームからの書き込み許可（認証不要）
    // 読み取りは owner/sub_owner のみ (PII の塊)。スタッフ・匿名は直読み禁止
    // → スタッフは /api/staff-data 経由で PII 除外サマリのみ取得する。
    match /guestRegistrations/{guestId} {
      // ★read を isMyProperty で物件スコープ(旧: isSubOwner() 無条件=全物件のゲストPII/氏名/電話/
      //   パスポートが横断で読めた穴)。フロントは sub_owner 時 propertyId in ownedPropertyIds で絞る。
      allow read: if isMyProperty(resource.data.propertyId);
      // ゲスト公開フォームからの新規登録を許可（source=guest_form のみ）
      allow create: if true
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() > 0
        && request.resource.data.source == "guest_form";
      // 更新・削除はオーナーのみ
      allow update, delete: if isOwner();
    }

    // スタッフ招待トークン — Cloud Functions Admin SDKのみアクセス
    match /staffInvites/{token} {
      allow read, write: if false;
    }

    // iCal同期設定 — オーナーは全件、サブオーナーは所有物件分のみ
    match /syncSettings/{settingId} {
      allow read: if isOwner()
        || (isSubOwner() && resource.data.propertyId in request.auth.token.ownedPropertyIds);
      allow update, delete: if isOwner()
        || (isSubOwner() && resource.data.propertyId in request.auth.token.ownedPropertyIds);
      allow create: if isOwner()
        || (isSubOwner() && request.resource.data.propertyId in request.auth.token.ownedPropertyIds);
    }

    // ダブルブッキング衝突記録 — オーナーのみ読み書き可（スタッフは read 不可）
    match /bookingConflicts/{id} {
      allow read, write: if isOwner();
    }

    // タイミー募集 — オーナーのみ
    match /timeeRequests/{requestId} {
      allow read, write: if isOwner();
    }

    // セッション状況 — 全セッションから書き込み可能（CTOダッシュボード用）
    match /sessions/{sessionId} {
      allow read: if isOwner();
      // 書き込み元 (biz-hq / biz-dashboard / 本アプリ) は全てオーナー認証済み (2026-06-13 絞り込み)
      allow create, update: if isOwner();
    }

    // タスクキュー — オーナーのみ（司令塔）
    match /tasks/{taskId} {
      allow read, write: if isOwner();
    }

    // プロジェクト管理 — オーナーのみ
    match /projects/{projectId} {
      allow read, write: if isOwner();
    }

    // 設定 — オーナーのみ (例外あり)
    // guestForm: 匿名ゲストも読取可
    match /settings/guestForm {
      allow read: if true;
      allow write: if isOwner();
    }
    // prepaidCards: スタッフは読取のみ、書き込みはオーナーのみ
    // 残高増減は Cloud Functions API 経由を推奨 (今後実装予定)
    match /settings/prepaidCards {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
    match /settings/laundryDepots {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }
    // GAS版差分チェック設定 — オーナーのみ読み書き可
    match /settings/gasComparison {
      allow read, write: if isOwner();
    }
    match /settings/{document=**} {
      allow read, write: if isOwner();
    }

    // ========== AI秘書「黒子」コレクション ==========

    // 秘書トップレベルドキュメント+サブコレクション — オーナーのみ
    match /secretary/{docId} {
      allow read, write: if isOwner();
      // 承認待ちサブコレクション
      match /approvals/items/{approvalId} {
        allow read, write: if isOwner();
      }
      // LINEメッセージ受信ログ
      match /inbox/messages/{messageId} {
        allow read, write: if isOwner();
      }
      // Gmail監視状態
      match /{subDoc=**} {
        allow read, write: if isOwner();
      }
    }

    // TODO — オーナーのみ
    match /todos/{todoId} {
      allow read, write: if isOwner();
    }

    // カレンダーイベント — オーナーのみ
    match /calendar_events/{eventId} {
      allow read, write: if isOwner();
    }

    // エラーログ — オーナーのみ読み取り、Cloud Functionsから書き込み
    match /error_logs/{logId} {
      allow read: if isOwner();
      // Cloud Functions (Admin SDK) はルールをバイパスするため公開許可は不要 (2026-06-13 絞り込み)
      allow create: if isOwner();
      allow update, delete: if isOwner();
    }

    // 通知ログ — オーナーのみ読み取り、Cloud Functionsから書き込み
    match /notifications/{notifId} {
      allow read: if isOwner();
      // Cloud Functions (Admin SDK) はルールをバイパスするため公開許可は不要 (2026-06-13 絞り込み)
      allow create: if isOwner();
      allow update, delete: if isOwner();
    }

    // バッチ通知キュー — Cloud Functions 専用 (クライアントはアクセス不可)
    match /notificationQueue/{queueId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // 直接予約リクエスト (承認制) — 読み取りはオーナー/サブオーナーのみ (管理画面は API 経由で取得するが念のため)。
    // 書き込みは Cloud Functions (Admin SDK) 専用 (公開エンドポイントからの新規作成・オーナー承認/却下ともにバイパス)
    match /bookingRequests/{requestId} {
      // ★read を isMyProperty で物件スコープ(旧: isSubOwner() 無条件)。管理UIは API 経由取得のため
      //   直読みは保険だが、sub_owner が他物件の予約リクエストを直読みできないよう締める。
      allow read: if isMyProperty(resource.data.propertyId);
      allow write: if false;
    }

    // 物件別 宿泊料金マスタ (ゲスト向け1泊料金。propertyWorkItems=スタッフ報酬単価 とは別物)
    // 予約サイトは公開API (/public/quote・/public/availability) 経由で読むため直読み不要。
    // read は認証済み (将来の料金管理UI用)、write はオーナー。日別 overrides / 締め後 history も同様。
    match /propertyRates/{propertyId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();

      // 特定日の料金上書き・売り止め
      match /overrides/{date} {
        allow read: if isAuthenticated();
        allow write: if isOwner();
      }
      // 締め後固定スナップショット (トリガー Admin SDK が書く想定。読み取りのみ)
      match /history/{yearMonth} {
        allow read: if isAuthenticated();
      }
    }

    // ========== 税理士資料収集 ==========

    // 名義・法人マスタ — オーナーのみ
    match /entities/{entityId} {
      allow read, write: if isOwner();
    }

    // 収集済み税理士資料 — オーナーのみ
    match /taxDocs/{docId} {
      allow read, write: if isOwner();
    }

    // 月次チェックリスト（名義別） — オーナーのみ
    match /taxDocsChecklist/{yearMonth} {
      allow read, write: if isOwner();
      match /entities/{entityId} {
        allow read, write: if isOwner();
      }
    }

    // メール照合機能: Gmail 巡回で保存される OTA メール生データ + 突合結果 — オーナーのみ
    // (settings/gmailOAuthEmailVerification は settings/{document=**} 既定ルールでカバー済)
    match /emailVerifications/{messageId} {
      allow read, write: if isOwner();
    }

    // Timee メール照合 — オーナーは全件、サブオーナーは自所有物件のもののみ read
    // 書き込みは Cloud Functions (Admin SDK) のみを想定
    match /timeeMatches/{messageId} {
      allow read: if isOwner()
        || (isSubOwner() && resource.data.propertyId in request.auth.token.ownedPropertyIds);
      allow write: if false;
    }

    // P1: メール照合パース失敗ログ (Cloud Functions Admin SDK で書込、オーナーは閲覧のみ)
    match /parse_errors/{messageId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // P1: 同期ジョブの健康状態 (Cloud Functions Admin SDK で更新、オーナーは閲覧のみ)
    match /syncHealth/{jobName} {
      allow read: if isOwner();
      allow write: if false;
    }

    // P1: 通知抑制ロック (Cloud Functions Admin SDK が管理)
    match /notification_locks/{lockKey} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ユーザー別通知既読状態: 本人 (uid 一致) のみ read/write 可能
    match /userNotificationStatus/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ユーザー別個人設定 (カレンダー表示形式のデフォルト等): 本人 (uid 一致) のみ read/write 可能
    match /userPreferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 定期報告（住宅宿泊事業法14条）
    // reports/{docId}: 報告済みフラグ・手動補正(overrides)を保持
    //   - 旧形式: bare periodId (例 "2026-02") = the Terrace 長浜の全体集計
    //   - 新形式: "{periodId}__{propertyId}" = 物件別
    // オーナーは全件、サブオーナーは自所有物件(propertyId)のもののみ
    match /reports/{docId} {
      allow read: if isOwner()
        || (isSubOwner()
            && (resource == null
                || (resource.data.propertyId is string
                    && resource.data.propertyId in request.auth.token.ownedPropertyIds)));
      allow write: if isOwner()
        || (isSubOwner()
            && request.resource.data.propertyId is string
            && request.resource.data.propertyId in request.auth.token.ownedPropertyIds);
    }

    // お知らせ — 認証済みは閲覧・投稿可能。編集・削除はオーナー or 投稿者本人のみ
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.title is string
                    && request.resource.data.body is string;
      allow update, delete: if isOwner()
                            || (isAuthenticated()
                                && resource.data.createdBy.uid == request.auth.uid);
    }

    // 月次収支 pnl 系 — オーナー限定(サブオーナーは自所有物件のみ read)。書き込みは API 経由のみで直書き禁止。
    match /propertyMonthlyPnL/{docId} {
      allow read: if isOwner()
        || (isSubOwner()
            && resource != null
            && resource.data.propertyId is string
            && resource.data.propertyId in request.auth.token.ownedPropertyIds);
      allow write: if false; // API(admin SDK)経由でのみ書き込み
    }

    // 費目マスタ — オーナー閲覧(サブオーナーも読み取りOK、書き込みは API 経由)
    match /expenseCategories/{catId} {
      allow read: if isOwner() || isSubOwner();
      allow write: if false;
    }

    // バッチ実行結果 — オーナー限定 read(サブオーナー不可)、書き込みは API 経由のみ
    match /pnlBatchRuns/{runId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // 募集・シフトの削除前退避 (キャンセル連動削除で消える responses の保険)
    // 書き込みは Cloud Functions (admin SDK) のみ。クライアントからは読取り専用。
    match /recruitmentArchives/{archiveId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // 通知の二重送信防止クレーム (create() の原子性で at-most-once を担保)
    // Cloud Functions 専用。クライアントは読み書きとも不要。
    match /notifyClaims/{claimId} {
      allow read, write: if false;
    }
  }
}
